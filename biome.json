{
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"overrides": [
		{
			"includes": ["package.json"],
			"formatter": {
				"indentStyle": "space",
				"indentWidth": 2
			}
		},
		{
			"includes": ["src/inpage.mjs"],
			"linter": {
				"rules": {
					"correctness": {
						"noUndeclaredVariables": "error"
					}
				}
			}
		}
	],
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json"
}
